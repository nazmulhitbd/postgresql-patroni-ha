[Unit]
Description=Patroni PostgreSQL High Availability
After=network-online.target etcd.service
Wants=network-online.target

[Service]
Type=simple

User=postgres
Group=postgres

ExecStart=/usr/local/bin/patroni /etc/patroni/patroni.yml

Restart=on-failure
RestartSec=5

TimeoutStartSec=0
KillMode=process

[Install]
WantedBy=multi-user.target


